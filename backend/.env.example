# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
DB_NAME=my_digital_project

# Application Configuration
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# JWT Authentication
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Password Hashing
HASH_SALT=10

# AWS S3 Configuration
AWS_REGION=eu-west-3
AWS_BUCKET=le-bon-fournisseur-files
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here

# Frontend URL (pour CORS)
FRONTEND_URL=http://localhost:5173

# Configuration de la base de données MySQL pour Docker
MYSQL_ROOT_PASSWORD=example_root_password
MYSQL_DATABASE=my_digital_project

# Configuration de PHPMyAdmin
PMA_HOST=database
PMA_PORT=3306
PMA_PASSWORD=example_root_password